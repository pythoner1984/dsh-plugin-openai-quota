{
  "name": "dsh-plugin-openai-quota",
  "version": "1.8.0",
  "type": "module",
  "description": "A one-line quota notice for DeepSeek Harness: DeepSeek balance, ChatGPT/Codex rate-limit windows and reset cards.",
  "license": "MIT",
  "author": "Tokamak (pythoner1984)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pythoner1984/dsh-plugin-openai-quota.git"
  },
  "homepage": "https://github.com/pythoner1984/dsh-plugin-openai-quota#readme",
  "bugs": {
    "url": "https://github.com/pythoner1984/dsh-plugin-openai-quota/issues"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "openai", "chatgpt", "codex", "quota"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "CHANGELOG.md"],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
